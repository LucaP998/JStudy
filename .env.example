# JStudy settings. Copy to .env (scripts/setup.sh does it for you) and adjust.
# Used by docker compose (web app) and by the worker. Keep comments on their own lines.

# Web app port, and the address it listens on. The app has no login: anyone who can
# reach it can generate questions with your Claude account. Keep it on your home
# network or a VPN (e.g. Tailscale), or set JSTUDY_BIND=127.0.0.1 for this machine only.
JSTUDY_PORT=8097
JSTUDY_BIND=0.0.0.0

# Owner of the files in ./data: your user and group id (`id -u`, `id -g`).
JSTUDY_UID=1000
JSTUDY_GID=1000

# Claude model that writes the questions: opus (best quality), sonnet, or haiku
# (cheapest, more mistakes).
JSTUDY_MODEL=opus

# Pause automatic question generation when the Claude subscription's 5-hour usage
# passes this fraction (0.85 = 85%). Your own requests and mock exams still run.
JSTUDY_AUTO_PAUSE=0.85

# Optional: path to the claude CLI if it is not on the PATH.
# JSTUDY_CLAUDE_BIN=/home/you/.local/bin/claude

# Optional: use a VOICEVOX engine you already run, instead of the one in compose.yaml.
# JSTUDY_VOICEVOX_URL=http://127.0.0.1:50021
# JSTUDY_MANAGE_VOICEVOX=0
